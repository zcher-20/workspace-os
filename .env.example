# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google OAuth (for Gmail sign-in)
# Create at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:8000/api/email/google/callback as authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (for Outlook sign-in)
# Create at: https://portal.azure.com > App registrations
# Add http://localhost:8000/api/email/microsoft/callback as redirect URI
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
